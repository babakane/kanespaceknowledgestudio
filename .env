# .env - Kanespace Knowledge Base Studio Configuration

# ============================================
# Google GenAI Configuration
# ============================================
VITE_API_KEY=your_google_genai_api_key_here

# ============================================
# Model Provider Selection
# ============================================
# Options: 'google' | 'huggingface'
VITE_MODEL_PROVIDER=google
# Fallback provider if primary fails
VITE_MODEL_FALLBACK_PROVIDER=huggingface

# ============================================
# Hugging Face Configuration
# ============================================
# Model name from Hugging Face Hub
VITE_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1
# Your Hugging Face API token
VITE_HF_API_KEY=your_hugging_face_api_token

# ============================================
# Cloud Storage Configuration
# ============================================
# Cloud storage provider: 'google-drive', 's3', 'dropbox', 'custom'
VITE_CLOUD_STORAGE_PROVIDER=google-drive

# Google Drive Configuration
# Format: https://drive.google.com/file/d/{FILE_ID}/view
# Extract {FILE_ID} and set below
VITE_GOOGLE_DRIVE_FILE_ID=your_google_drive_file_id
# Download link format: https://drive.google.com/uc?id={FILE_ID}&export=download
VITE_MODEL_STORAGE_URL=https://drive.google.com/uc?id=your_file_id&export=download

# AWS S3 Configuration
VITE_AWS_S3_BUCKET=your-bucket-name
VITE_AWS_S3_KEY=path/to/model
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
VITE_AWS_REGION=us-east-1

# Dropbox Configuration
VITE_DROPBOX_TOKEN=your_dropbox_access_token
VITE_DROPBOX_PATH=/Models/your-model.tar.gz

# ============================================
# Model Caching Configuration
# ============================================
VITE_MODEL_CACHE_DIR=./models
VITE_ENABLE_RESPONSE_CACHING=true

# ============================================
# Cloud API Server Configuration
# ============================================
# Set to true to use remote API server instead of local inference
VITE_USE_CLOUD_API=false
VITE_API_ENDPOINT=http://localhost:5000

# ============================================
# Performance Configuration
# ============================================
# Maximum context window for model
VITE_MAX_CONTEXT_LENGTH=2000
# Inference timeout in milliseconds
VITE_INFERENCE_TIMEOUT=60000
# Batch size for processing
VITE_BATCH_SIZE=1
